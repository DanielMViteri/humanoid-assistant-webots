WorldInfo {
  info [
    "Saturday demo world for the humanoid assistant using the official SoftBank NAO model."
    "The invisible supervisor consumes the voice pipeline command file and moves the visible NAO through the home scene."
  ]
  title "NAO House Demo"
  basicTimeStep 20
  FPS 20
  contactProperties [
    ContactProperties {
      material1 "Nao foot material"
      coulombFriction [
        8.24
      ]
      bounce 0.9
      bounceVelocity 0.003
    }
  ]
}
